{
  "name": "jarvis-desktop",
  "version": "1.3.9",
  "description": "Futuristic Windows desktop HUD for Jarvis voice & text automation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "Jarvis",
    "publish": [
      {
        "provider": "github",
        "owner": "adandavid98",
        "repo": "Jarvis",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources-build/jarvis-bridge",
        "to": "jarvis-bridge"
      }
    ],
    "win": {
      "icon": "assets/jarvis-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Jarvis-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
