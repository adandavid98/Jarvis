# Required: Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model: "gemini-3.8-live" (lowest-latency voice + async tools, recommended default)
# or "gemini-3.8-live-extended-thinking" (background reasoning)
JARVIS_MODEL=gemini-3.8-live
JARVIS_THINKING_LEVEL=low
JARVIS_VOICE_NAME=Fenrir

# Wake word settings (openWakeWord)
JARVIS_WAKE_WORD=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_IDLE_TIMEOUT_SEC=45

# Workspace root for developer / file tools (defaults to current working dir)
JARVIS_WORKSPACE_DIR=.

# Optional named webhook endpoints (JSON object mapping alias -> URL)
# Example: JARVIS_WEBHOOKS={"n8n_brief":"http://localhost:5678/webhook/daily-brief"}
JARVIS_WEBHOOKS={}

# Safety: set to "true" to skip interactive confirmation prompts for shell/write actions
JARVIS_AUTO_APPROVE_DANGEROUS=false

# Speaker echo guard: set to "false" (or pass --barge-in) when using headphones
JARVIS_MUTE_WHILE_SPEAKING=true
